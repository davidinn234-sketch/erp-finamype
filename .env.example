# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Model used by the AI endpoints; may be changed without editing source code.
GEMINI_MODEL="gemini-2.5-flash"
# Firebase Admin SDK uses Application Default Credentials on Cloud Run.
# For local use, GOOGLE_APPLICATION_CREDENTIALS must point to a private file
# outside this repository. Never paste or commit that file.
FIREBASE_PROJECT_ID="mi-erp-nube"
FIRESTORE_DATABASE_ID="ai-studio-nexuserpsalvador-619c5a84-1f5d-4833-aee7-65b2a99f4a3b"
# Vercel: set FIREBASE_SERVICE_ACCOUNT_JSON privately in Project Settings.
# Paste the complete service-account JSON there; do not put its value here.
# Never prefix private credentials with VITE_.
# Local tests only. Production always uses the real Firebase project.
VITE_USE_FIREBASE_EMULATORS="false"
